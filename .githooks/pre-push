#!/usr/bin/env bash
# Blocks pushes that break the collaboration rules (docs/agents/COLLABORATION.md §3):
# - every commit authored AND committed by Zare2001
# - no AI attribution lines in messages
# - no commit larger than FLHUB_MAX_LINES changed lines (lockfiles excluded)
# - no more than FLHUB_MAX_COMMITS commits per push
# - no forbidden files (secrets, startup kits, data, weights)
set -euo pipefail
MAX_LINES="${FLHUB_MAX_LINES:-400}"
MAX_COMMITS="${FLHUB_MAX_COMMITS:-8}"
OWNER="${GH_USER:-Zare2001}"
ZERO=0000000000000000000000000000000000000000
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    commits="$(git rev-list "$local_sha" --not --remotes)"
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi
  n="$(echo "$commits" | grep -c . || true)"
  if [ "$n" -gt "$MAX_COMMITS" ] && [ "${FLHUB_ALLOW_BIG_PUSH:-0}" != 1 ]; then
    echo "pre-push: $n commits in one push (max $MAX_COMMITS). Push more often." >&2; fail=1
  fi
  for c in $commits; do
    an="$(git log -1 --format=%an "$c")"; cn="$(git log -1 --format=%cn "$c")"
    if [ "$an" != "$OWNER" ] || [ "$cn" != "$OWNER" ]; then
      echo "pre-push: $c author/committer is '$an'/'$cn', must be '$OWNER'" >&2; fail=1
    fi
    if git log -1 --format=%B "$c" | grep -Eiq 'co-authored-by:|generated with|claude\.ai/code|noreply@anthropic\.com|🤖'; then
      echo "pre-push: $c contains AI attribution in its message" >&2; fail=1
    fi
    lines="$(git show --numstat --format= "$c" | grep -Ev '(\.lock|uv\.lock|package-lock\.json)$' \
             | awk '$1 != "-" {s += $1 + $2} END {print s+0}')"
    if [ "$lines" -gt "$MAX_LINES" ] && [ "${FLHUB_ALLOW_LARGE:-0}" != 1 ]; then
      echo "pre-push: $c changes $lines lines (max $MAX_LINES). Split it into smaller commits." >&2; fail=1
    fi
    if git show --name-only --format= "$c" | grep -Eiq '(secrets\.env$|\.pem$|\.key$|startup/|api_key|\.safetensors$|\.pt$|\.npz$|^data/|wandb/)'; then
      echo "pre-push: $c adds a forbidden file (secret/kit/data/weights):" >&2
      git show --name-only --format= "$c" | grep -Ei '(secrets\.env$|\.pem$|\.key$|startup/|api_key|\.safetensors$|\.pt$|\.npz$|^data/|wandb/)' >&2
      fail=1
    fi
  done
done

if [ "$fail" != 0 ]; then
  echo "pre-push: push blocked. Fix with 'git reset --soft' / 'git commit --amend' / split commits, then push again." >&2
  exit 1
fi
