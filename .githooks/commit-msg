#!/usr/bin/env bash
# Enforces the project's commit message rules (docs/agents/COLLABORATION.md §3).
# 1. Strips any AI attribution trailers/lines (commits are authored by Zare2001 only).
# 2. Subject <= 72 chars, at most 4 non-empty body lines.
set -euo pipefail
MSG_FILE="$1"

# strip attribution lines, comment lines and trailing blank lines
python3 - "$MSG_FILE" <<'PY'
import re, sys
p = sys.argv[1]
bad = re.compile(r"(co-authored-by:|generated with|claude\.ai/code|claude-session:|noreply@anthropic\.com|🤖)", re.I)
lines = [l.rstrip() for l in open(p, encoding="utf-8").read().splitlines()]
lines = [l for l in lines if not l.startswith("#") and not bad.search(l)]
while lines and not lines[-1]:
    lines.pop()
open(p, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY

subject="$(head -n1 "$MSG_FILE")"
body_lines="$(tail -n +2 "$MSG_FILE" | grep -cv '^[[:space:]]*$' || true)"

if [ -z "$subject" ]; then echo "commit-msg: empty subject" >&2; exit 1; fi
if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} chars (max 72). Keep it short: '<scope>: <what>'" >&2; exit 1
fi
if [ "$body_lines" -gt 4 ]; then
  echo "commit-msg: body has $body_lines lines (max 4). Keep messages short and concise." >&2; exit 1
fi
