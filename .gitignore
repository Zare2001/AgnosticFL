# secrets & runtime state (never commit)
secrets.env
.env
*.pem
*.key
*.crt
**/startup/
**/prod_*/
api_keys*.yaml
flhub-runtime/

# data, models, experiment artefacts
data/
*.csv
*.parquet
*.npz
*.npy
*.pt
*.pth
*.safetensors
wandb/
artifacts/
checkpoints/

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# misc
.DS_Store
*.log
nohup.out

# your own plugins (models, datasets) live on the operator's machine, not in git (flhub_core/plugins/__init__.py)
flhub_core/src/flhub_core/plugins/*
!flhub_core/src/flhub_core/plugins/__init__.py
!flhub_core/src/flhub_core/plugins/_example_*.py
