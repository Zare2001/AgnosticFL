# Pinned versions for all VMs and images (P0, central). Source it: . deploy/versions.env
# Changing a pin needs an ADR in docs/DECISIONS.md and a `push` announcement with pull: yes.

PYTHON_VERSION=3.11.17                 # uv-managed CPython; Docker images use python:3.11.17-slim-bookworm
TORCH_VERSION=2.14.1                   # CPU build, the SAME on every VM and in the vantage6 image
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
NUMPY_VERSION=2.4.4                    # last numpy line that supports Python 3.11
SAFETENSORS_VERSION=0.8.0
PYYAML_VERSION=6.0.3
WANDB_VERSION=0.30.0                   # hub venv only (central orchestrator)

NVFLARE_VERSION=2.9.0                  # latest stable 2.x
VANTAGE6_VERSION=4.15.2                # latest 4.15.x (Docker-based); NOT 5.x
FLWR_VERSION=1.39.0                    # latest stable Flower

V6_ALGO_BASE_IMAGE=python:3.11.17-slim-bookworm
REGISTRY_IMAGE=registry:2

# Install torch first, from the CPU index, then everything else from PyPI:
#   uv venv --python "$PYTHON_VERSION" ~/venvs/<name>
#   uv pip install --python ~/venvs/<name>/bin/python "torch==${TORCH_VERSION}+cpu" --index-url "$TORCH_INDEX_URL"
#   uv pip install --python ~/venvs/<name>/bin/python "numpy==$NUMPY_VERSION" "safetensors==$SAFETENSORS_VERSION" -e ./flhub_core
