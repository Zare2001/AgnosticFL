# Network topology for the AgnosticFL test network (committed; no secrets here).
# Source it in scripts:  . deploy/topology.env

FLHUB_CENTRAL_IP=145.38.205.58
FLHUB_NVFLARE_IP=145.38.189.142
FLHUB_VANTAGE6_IP=145.38.186.63
FLHUB_FLOWER_IP=145.38.187.20
FLHUB_CENTRAL_HOSTNAME=flhub-central      # /etc/hosts alias on all VMs (NVFlare server name)

# --- central VM ports (public = opened to the framework VMs; local = 127.0.0.1 only) ---
AGENTBUS_PORT=7700        # public: all VMs        agent-to-agent bus (build time only)
HUB_CORE_PORT=8800        # local                  hub core API + blob store
ADAPTER_NVFLARE_PORT=8811 # local                  NVFlare adapter (JSON-RPC)
ADAPTER_V6_PORT=8812      # local                  vantage6 adapter (JSON-RPC)
ADAPTER_FLOWER_PORT=8813  # local                  Flower adapter (JSON-RPC)
NVFLARE_FL_PORT=8002      # public: NVFlare VM     NVFlare server <- hospital clients
NVFLARE_ADMIN_PORT=8003   # local                  NVFlare admin / FLARE API
V6_SERVER_PORT=7601       # public: vantage6 VM    vantage6 server API <- hospital nodes
REGISTRY_PORT=5050        # public: vantage6 VM    Docker registry for the vantage6 algorithm image
FLOWER_SERVERAPPIO_PORT=9091  # local              Flower SuperLink ServerAppIo
FLOWER_FLEET_PORT=9092    # public: Flower VM      Flower SuperLink Fleet API <- hospital SuperNodes
FLOWER_CONTROL_PORT=9093  # local                  Flower SuperLink Control API (flwr run)

# --- simulated hospitals (site_id -> framework, VM, data partition index) ---
SITES="nvf-h1:nvflare:0 nvf-h2:nvflare:1 v6-h3:vantage6:2 v6-h4:vantage6:3 flw-h5:flower:4 flw-h6:flower:5"
